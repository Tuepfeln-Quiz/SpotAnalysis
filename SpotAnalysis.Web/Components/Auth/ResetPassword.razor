@using System.Text.RegularExpressions
@inject IUserService UserService
@inject ISessionService SessionService
@inject NavigationManager NavigationManager

<EditForm Model="@ResetVm" OnValidSubmit="HandleResetPassword" FormName="ResetForm">
    <DataAnnotationsValidator/>
    <div class="mb-3 text-center">
        <UsernameGenerator @bind-Value="ResetVm.UserName" AutoGenerate="false"/>
        <label class="username-label text-gray"><b>* optional: generate new username</b></label>
        <ValidationMessage For="() => ResetVm.UserName"/>
    </div>
    <div class="mb-3">
        <InputText @bind-Value="ResetVm.OldPassword" placeholder="Old Password" type="password"
                   class="form-control"/>
        <ValidationMessage For="() => ResetVm.OldPassword"/>
    </div>
    <div class="mb-3">
        <InputText @bind-Value="ResetVm.NewPassword" placeholder="New Password" type="password"
                   class="form-control"/>
        <ValidationMessage For="() => ResetVm.NewPassword"/>
    </div>
    <div class="mb-3">
        <InputText @bind-Value="ConfirmPassword" placeholder="Confirm Password" type="password"
                   class="form-control"/>
    </div>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }
    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsLoading">
            @(IsLoading ? "Resetting..." : "Reset Password")
        </button>
    </div>
</EditForm>

<style>
    .username-label {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.25rem;
        font-size: 0.875rem;
    }
</style>

@code {
    [Parameter] [EditorRequired] public Guid UserId { get; set; }
    [Parameter] [EditorRequired] public string UserName { get; set; } = string.Empty;

    public ResetPasswordDto ResetVm { get; set; } = new() { UserName = string.Empty, NewPassword = string.Empty, OldPassword = string.Empty };
    public string ConfirmPassword { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool IsLoading { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(UserName))
        {
            ResetVm.UserName = UserName;
        }
    }

    private async Task HandleResetPassword()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrEmpty(ResetVm.UserName))
        {
            ErrorMessage = "Username is required.";
            return;
        }

        if (!IsValidPassword(ResetVm.NewPassword))
        {
            ErrorMessage = "Password must be at least 8 characters with uppercase, lowercase, number and special character.";
            return;
        }

        if (ResetVm.NewPassword != ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        IsLoading = true;
        try
        {
            await UserService.ChangePassword(UserId, ResetVm.OldPassword, ResetVm.NewPassword);
            await SessionService.InvalidateAllForUser(UserId);
            SuccessMessage = "Password reset successfully! You can now login.";
            await Task.Delay(1500);
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static bool IsValidPassword(string? pw)
    {
        if (string.IsNullOrEmpty(pw)) return false;
        return Regex.IsMatch(pw, @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{8,}$", RegexOptions.None);
    }

}
