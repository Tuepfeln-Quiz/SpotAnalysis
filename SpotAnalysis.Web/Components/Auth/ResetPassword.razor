@page "/reset-password"
@using System.Text.RegularExpressions
@attribute [Authorize]
@inject IUserService UserService;
@inject NavigationManager NavigationManager;
@inject IHttpContextAccessor HttpContextAccessor;
@inject AuthenticationStateProvider AuthStateProvider;

 <div class="row justify-content-center min-vh-100 align-items-center p-4">
    <div class="col-lg-4 col-md-6 col-sm-10 pt-4 pb-4 border border-secondary rounded">
        <EditForm Model="@ResetVm" OnValidSubmit="HandleResetPassword" FormName="ResetForm">
            <DataAnnotationsValidator />
            <div class="mb-3 text-center flex-column">
                <h3>Reset Password</h3>
            </div>
            <div class="mb-3 text-center">
                <UsernameGenerator @bind-Value="ResetVm.UserName" AutoGenerate="false"/>
                <label class="username-label text-gray"><b>* optional: generate new username</b></label>
                <ValidationMessage For="() => ResetVm.UserName"/>
            </div>
            <div class="mb-3">
                <InputText @bind-Value="ResetVm.OldPassword" placeholder="Old Password" type="password"
                           class="form-control"/>
                <ValidationMessage For="() => ResetVm.OldPassword"/>
            </div>
            <div class="mb-3">
                <InputText @bind-Value="ResetVm.NewPassword" placeholder="New Password" type="password"
                           class="form-control"/>
                <ValidationMessage For="() => ResetVm.NewPassword"/>
            </div>
            <div class="mb-3">
                <InputText @bind-Value="ConfirmPassword" placeholder="Confirm Password" type="password" class="form-control" />
            </div>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }
            
            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success">@SuccessMessage</div>
            }
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary" disabled="@IsLoading">
                    @(IsLoading ? "Resetting..." : "Reset Password")
                </button>
            </div>
        </EditForm>
        <div class="mt-3 text-center">
            <a href="/login">Back to Login</a>
        </div>
    </div>
</div>

<style>
    .username-label {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.25rem;
        font-size: 0.875rem;
    }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;
    private Guid _userId;
    private string _userName = null!;

    public ResetPasswordDto ResetVm { get; set; } = new() { UserName = string.Empty, NewPassword = string.Empty, OldPassword = string.Empty };
    public string ConfirmPassword { get; set; } = string.Empty;
    
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _userId = Guid.Parse(auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
        _userName = auth.User.FindFirst(ClaimTypes.Name)!.Value;

        if (!string.IsNullOrEmpty(_userName))
        {
            ResetVm.UserName = _userName;
        }

        await InvokeAsync(StateHasChanged);
    }
    private async Task HandleResetPassword()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        if (string.IsNullOrEmpty(ResetVm.UserName))
        {
            ErrorMessage = "Username is required.";
            return;
        }

        if (!IsValidPassword(ResetVm.NewPassword))
        {
            ErrorMessage = "Password must be at least 8 characters with uppercase, lowercase, number and special character.";
            return;
        }

        if (ResetVm.NewPassword != ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }
        IsLoading = true;
        try
        {
            await UserService.ChangePassword(_userId, ResetVm.OldPassword, ResetVm.NewPassword);

            SuccessMessage = "Password reset successfully! You can now login.";
            await Task.Delay(1500);
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception)
        {
            ErrorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static bool IsValidPassword(string? pw)
    {
        if (string.IsNullOrEmpty(pw)) return false;
        return Regex.IsMatch(pw,
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{8,}$",
            RegexOptions.None);
    }
    
}
