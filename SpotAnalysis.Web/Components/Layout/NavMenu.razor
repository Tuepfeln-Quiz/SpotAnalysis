@inject NavigationManager NavigationManager

<div class="navbar-container">
    <div class="navbar-header">
        <button class="burger-btn" @onclick="ToggleMenu">
            <i class="bi @(_isMenuOpen ? "bi-x-lg" : "bi-list")"></i>
        </button>
        <button class="home-btn" @onclick="NavigateAndCloseMenu">
            <i class="bi bi-house"></i>
        </button>

        <div class="user-greeting">
            <AuthorizeView>
                <Authorized>
                    <span>Welcome, <b class="text-warning cursor-pointer"
                                      @onclick="ToggleDropdown">@context.User.Identity?.Name</b></span>
                </Authorized>
                <NotAuthorized>
                    <span>Welcome, <b class="text-warning">Tüpfler</b></span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <div class="relative" @onclick:stopPropagation>
            <AuthorizeView>
                <Authorized>
                    <button class="btn-user" type="button" @onclick="ToggleDropdown">
                        <img src="/images/science.svg" class="user-avatar" alt="science image"/>
                    </button>

                    @if (_isDropdownOpen)
                    {
                        <div class="fixed inset-0 z-10" @onclick="CloseAll"></div>

                        <ul class="dropdown-menu show dropdown-menu-end z-20" style="position:absolute; padding: 28px; right:0; top:100%">
                            <li><span class="dropdown-item-text">@context.User.Identity?.Name</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="btn btn-info mb-2" href="/user/account" @onclick="CloseAll">My account</a>
                            </li>
                            <li>
                                <form method="post" action="/api/auth/logout">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-box-arrow-left"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login" class="btn btn-primary w-100" @onclick="CloseAll">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>


    <div class="nav-menu @(_isMenuOpen ? "open" : "")">
        <div class="nav-links">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink class="nav-link-item" href="/admin" Match="NavLinkMatch.All" @onclick="CloseAll">
                        <i class="bi bi-person-lines-fill"></i> Admin
                    </NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin,Teacher">
                <Authorized>
                    <NavLink class="nav-link-item" href="/teacher" Match="NavLinkMatch.All" @onclick="CloseAll">
                        <i class="bi bi-person-badge"></i> Teacher area
                    </NavLink>
                    @*
                    Statistiken-Feature existiert noch nicht — Link vorerst ausgeblendet, damit kein 404/Missing-Page angezeigt wird.
                    <NavLink class="nav-link-item" href="/statistics" Match="NavLinkMatch.All" @onclick="CloseAll">
                        <i class="bi bi-bar-chart"></i> Statistiken
                    </NavLink>
                    *@
                </Authorized>
            </AuthorizeView>
            <NavLink class="nav-link-item" href="/" Match="NavLinkMatch.All" @onclick="CloseAll">
                <i class="bi bi-lightbulb"></i> Quizzes
            </NavLink>
        </div>
        <div class="nav-auth">
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/api/auth/logout">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="bi bi-box-arrow-left"></i> Logout
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="/login" class="btn btn-primary w-100" @onclick="CloseAll">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@if (_isMenuOpen || _isDropdownOpen)
{
    <div class="nav-overlay" @onclick="CloseAll"></div>
}


@code {
    private bool _isMenuOpen;
    private bool _isDropdownOpen;

    private void ToggleMenu() => _isMenuOpen = !_isMenuOpen;
    private void ToggleDropdown() => _isDropdownOpen = !_isDropdownOpen;

    private void CloseAll()
    {
        _isMenuOpen = false;
        _isDropdownOpen = false;
    }

    private void NavigateAndCloseMenu() {
        CloseAll();
        NavigationManager.NavigateTo("/");
    }
}
