<div class="color-picker position-relative" @onclick:stopPropagation="true">
    <div class="d-flex gap-2 align-items-center">
        <button type="button"
                class="color-picker-swatch border @(FindColor(Value)?.IsColorless == true ? "color-picker-swatch-colorless" : "")"
                style="@(FindColor(Value) is { IsColorless: false } c ? $"background-color: {c.HexValue};" : "")"
                title="Farbe aus Palette auswählen"
                @onclick="TogglePalette"></button>
        <input type="text" class="form-control input-custom"
               placeholder="@Placeholder"
               value="@Value"
               @oninput="e => OnInput(e.Value?.ToString())" />
    </div>

    @if (_open)
    {
        <div class="color-picker-popover bg-white border rounded shadow p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="small">Farbe auswählen</strong>
                <button type="button" class="btn-close" aria-label="Schließen"
                        style="font-size:0.7rem;" @onclick="() => _open = false"></button>
            </div>
            <div class="color-picker-grid">
                @foreach (var color in _palette)
                {
                    <button type="button"
                            class="color-picker-chip border @(IsSelected(color.Name) ? "color-picker-chip-selected" : "")"
                            title="@color.Name"
                            @onclick="() => SelectColor(color.Name)">
                        <span
                            class="color-picker-chip-fill @(color.IsColorless ? "color-picker-chip-fill-colorless" : "")"
                            style="@(color.IsColorless ? "" : $"background-color: {color.HexValue};")"></span>
                        <span class="color-picker-chip-label">@color.Name</span>
                    </button>
                }
            </div>
            <div class="text-muted small mt-2">
                Nicht dabei? Einfach in das Feld tippen — bei unbekannten Farben wird ein Hinweis angezeigt.
            </div>
        </div>
    }

    @if (UnknownColorWarning(Value) is { } warn)
    {
        <div class="text-warning small mt-1">
            <i class="bi bi-exclamation-triangle me-1"></i>@warn
        </div>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ColorDto> AvailableColors { get; set; } = [];

    private bool _open;
    private IReadOnlyList<ColorDto> _palette = [];

    protected override void OnParametersSet()
    {
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _palette = AvailableColors.Where(c => seen.Add(c.HexValue)).ToList();
    }

    private ColorDto? FindColor(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? null
            : AvailableColors.FirstOrDefault(c => c.Name.Equals(name.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task OnInput(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

    private async Task SelectColor(string name)
    {
        Value = name;
        _open = false;
        await ValueChanged.InvokeAsync(name);
    }

    private void TogglePalette() => _open = !_open;

    private bool IsSelected(string name) =>
        !string.IsNullOrWhiteSpace(Value)
        && string.Equals(Value.Trim(), name, StringComparison.OrdinalIgnoreCase);

    private string? UnknownColorWarning(string? color)
    {
        if (string.IsNullOrWhiteSpace(color)) return null;
        if (FindColor(color) != null) return null;
        return $"\"{color.Trim()}\" ist keine bekannte Farbe — Icon wird grau dargestellt.";
    }
}
