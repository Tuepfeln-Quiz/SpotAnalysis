@using SpotAnalysis.Data.Models.Identity
<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title mb-0">Active Sessions</h5>
        </div>

        @if (Sessions.Count == 0)
        {
            <p class="text-muted">No active sessions found.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var session in Sessions)
                {
                    var isCurrent = session.SessionId == CurrentSession;
                    <div
                        class="list-group-item d-flex justify-content-between align-items-start align-items-center @(isCurrent ? "list-group-item-info" : "")">
                        <div>
                            <div class="fw-bold">
                                @(session.UserAgent ?? "Unknown device")
                                @if (isCurrent)
                                {
                                    <span class="badge bg-primary ms-2">Current</span>
                                }
                            </div>
                            <small class="text-muted">
                                Started: @session.StartTime.ToString("g") &middot;
                                Expires: @session.Expiry.ToString("g")
                                @if (session.IpAddress is not null)
                                {
                                    <span>&middot; IP: @session.IpAddress</span>
                                }
                            </small>
                        </div>
                        @if (!isCurrent && Revoke is not null)
                        {
                            <button class="btn btn-outline-danger btn-sm align-middle"
                                    @onclick="() => Revoke(session.SessionId)">
                                Revoke
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] [EditorRequired] public required List<Session> Sessions { get; set; }
    [Parameter] public Guid? CurrentSession { get; set; }
    [Parameter] public Func<Guid, Task>? Revoke { get; set; }
}
