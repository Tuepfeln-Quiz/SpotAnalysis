<div class="container-fluid p-0"
     @ondrop="MixDropOutside"
     @ondrop:preventDefault
     @ondragover:preventDefault>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-2">
                <i class="bi bi-question-circle me-2 text-primary"></i>Task
            </h5>
            <p class="mb-0 fs-5">@Description</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-eye-slash me-2"></i>Unknown educts</h5>
            <div class="d-flex flex-wrap gap-3">
                @for (var i = 0; i < Question.UnknownEducts.Count; i++)
                {
                    var educt = Question.UnknownEducts[i];
                    var idx = i;
                    var eigenfarbe = string.IsNullOrWhiteSpace(educt.Color.Name) ? null : educt.Color;
                    var phPaper = educt.MethodOutputs.GetValueOrDefault(Method.PhPaper);
                    var flame = educt.MethodOutputs.GetValueOrDefault(Method.FlameColoration);

                    var borderColor = eigenfarbe?.BorderColor ?? "transparent";
                    if (_hasChecked && _answerResults.TryGetValue(idx, out var correct))
                        borderColor = correct ? "#16a34a" : "#dc2626";
                    else if (_dragOverEductIndex == idx)
                        borderColor = "#6b21a8";

                    <div
                        class="educt-box chemical-@(educt.Type.ToString().ToLowerInvariant()) @(_dragOverEductIndex == idx ? "drag-over" : "")"
                         style="border-color: @borderColor;"
                         draggable="true"
                        @ondragstart="@(() => StartDragEduct(idx))"
                        @ondrop="@(() => HandleDropOnEduct(idx))"
                         @ondrop:preventDefault
                         @ondrop:stopPropagation
                        @ondragover="@(() => _dragOverEductIndex = idx)"
                         @ondragover:preventDefault
                        @ondragleave="@(() =>
                                      {
                                          if (_dragOverEductIndex == idx) _dragOverEductIndex = -1;
                                      })">
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="fw-bold fs-5">@(idx + 1)</span>
                            <input type="text" class="form-control form-control-sm flex-grow-1 @GetAnswerResultClass(idx)"
                                   placeholder="Formula"
                                   value="@_answers[idx]"
                                   @onchange="(e) => _answers[idx] = e.Value?.ToString() ?? string.Empty"
                                   disabled="@_hasChecked" />
                            @if (_hasChecked && _answerResults.TryGetValue(idx, out var isCorrect))
                            {
                                <i class="bi @(isCorrect ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                            }
                        </div>
                        @if (_hasChecked && _answerResults.TryGetValue(idx, out var wasCorrect) && !wasCorrect)
                        {
                            <small class="text-muted">Correct: <strong>
                                    <ChemFormula Value="@educt.Formula"/>
                                </strong></small>
                        }
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            @if (eigenfarbe != null)
                            {
                                <small title="Own color" style="color: @eigenfarbe.HexValue;"><strong>
                                        <TestTubeIcon/> @eigenfarbe.Name</strong></small>
                            }
                            @if (_revealedMethods.GetValueOrDefault(idx)?.Contains(Method.FlameColoration) == true && flame != null)
                            {
                                <small title="Flame coloration" style="color: @flame.HexValue;"><strong>
                                        <FlameIcon/> @flame.Name</strong></small>
                            }
                            @if (_revealedMethods.GetValueOrDefault(idx)?.Contains(Method.PhPaper) == true && phPaper != null)
                            {
                                <small title="pH paper coloration"
                                       style="color: @phPaper.HexValue;"><strong>
                                        <PhPaperIcon/> @phPaper.Name</strong></small>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-4">
                @if (!_hasChecked)
                {
                    <button class="btn btn-primary" @onclick="CheckAnswers"
                            disabled="@_answers.Values.Any(string.IsNullOrWhiteSpace)">
                        <i class="bi bi-check-lg me-1"></i> Check
                    </button>
                }
                else
                {
                    @if (_answerResults.Values.Any(r => !r))
                    {
                        <button class="btn btn-outline-primary" @onclick="RetryQuestion">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Retry
                        </button>
                    }
                    <button class="btn btn-primary" @onclick="Continue">
                        <i class="bi bi-arrow-right me-1"></i> Continue
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-moisture me-2"></i>Mixing area</h5>
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="drop-zone @(_mixDragOverSlot == 1 ? "drag-over" : "")"
                         @ondrop="() => MixDrop(1)"
                         @ondrop:preventDefault
                         @ondrop:stopPropagation
                         @ondragover="@(() => _mixDragOverSlot = 1)"
                         @ondragover:preventDefault
                         @ondragleave="@(() => _mixDragOverSlot = 0)">
                        @if (_mixSlot1 is { } slot1)
                        {
                            <div
                                class="compound-card chemical-@(slot1.Kind == DragKind.Educt ? "educt" : "method") d-flex align-items-center justify-content-center"
                                 draggable="true"
                                @ondragstart="@(() => { _mixDragSource = 1; })">
                                <strong>@slot1.Label</strong>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                <i class="bi bi-plus-circle fs-3 d-block mb-2"></i>
                                Drag here
                            </div>
                        }
                    </div>
                </div>
                <div class="col-6">
                    <div class="drop-zone @(_mixDragOverSlot == 2 ? "drag-over" : "")"
                         @ondrop="() => MixDrop(2)"
                         @ondrop:preventDefault
                         @ondrop:stopPropagation
                         @ondragover="@(() => _mixDragOverSlot = 2)"
                         @ondragover:preventDefault
                         @ondragleave="@(() => _mixDragOverSlot = 0)">
                        @if (_mixSlot2 is { } slot2)
                        {
                            <div
                                class="compound-card d-flex align-items-center justify-content-center chemical-@(slot2.Kind == DragKind.Chemical ? "additive" : "educt")"
                                 draggable="true"
                                @ondragstart="@(() => { _mixDragSource = 2; })">
                                <strong>@slot2.Label</strong>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">
                                <i class="bi bi-plus-circle fs-3 d-block mb-2"></i>
                                Drag here
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="ExecuteMix"
                        disabled="@(_mixSlot1 == null || _mixSlot2 == null || _hasChecked)">
                    <i class="bi bi-play-fill me-1"></i> Mischen
                </button>
                <button class="btn btn-outline-secondary" @onclick="ClearMixSlots">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </button>
            </div>

            @if (_mixError != null)
            {
                <div class="alert alert-warning py-2 mt-3 mb-0">@_mixError</div>
            }
        </div>
    </div>

    @if (_actionLog.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Action log</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th style="width: 30%;">Left</th>
                                <th style="width: 5%;" class="text-center">+</th>
                                <th style="width: 30%;">Right</th>
                                <th style="width: 5%;" class="text-center">→</th>
                                <th>Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in _actionLog)
                            {
                                <tr>
                                    <td>@log.Left</td>
                                    <td class="text-center">+</td>
                                    <td>@log.Right</td>
                                    <td class="text-center">→</td>
                                    <td class="fw-semibold">@log.Result</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<button class="tools-panel-toggle" @onclick="() => _toolsPanelOpen = !_toolsPanelOpen">
    <i class="bi @(_toolsPanelOpen ? "bi-x-lg" : "bi-tools")"></i>
</button>

<div class="tools-panel @(_toolsPanelOpen ? "open" : "")">
    <h5 class="fw-bold mb-3"><i class="bi bi-tools me-2"></i>Tools</h5>

    @if (Question.AvailableMethods.Count > 0)
    {
        <h6 class="text-muted fw-semibold mt-3 mb-2">Methods</h6>
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var method in Question.AvailableMethods)
            {
                <div class="compound-card compound-card-static chemical-educt"
                     draggable="true"
                     style="cursor: grab;"
                     @ondragstart="@(() => StartDragMethod(method))">
                    @switch (method)
                    {
                        case Method.PhPaper:
                            <strong>
                                <PhPaperIcon Size="16"/> @method</strong>
                            break;
                        case Method.FlameColoration:
                            <strong>
                                <FlameIcon Size="16"/> @method</strong>
                            break;
                        default:
                            <strong>@method</strong>
                            break;
                    }
                </div>
            }
        </div>
    }

    @if (Question.AvailableAdditives.Count > 0)
    {
        <h6 class="text-muted fw-semibold mt-3 mb-2">Additives</h6>
        <div class="d-flex flex-column gap-2 mb-3">
            @foreach (var chem in Question.AvailableAdditives)
            {
                <div class="compound-card chemical-@(chem.Type.ToString().ToLowerInvariant())"
                     style="border-color: @chem.Color.BorderColor; cursor: grab;"
                     draggable="true"
                     @ondragstart="@(() => StartDragChemical(chem))">
                    <SubstanceCard Chemical="chem" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public SpotTestPayloadDto Question { get; set; } = null!;
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter, EditorRequired] public List<LabReactionDto> AllReactions { get; set; } = [];
    [Parameter, EditorRequired] public EventCallback<SpotTestAnswered> OnAnswered { get; set; }

    private enum DragKind
    {
        None,
        Method,
        Chemical,
        Educt
    }

    private record struct DragPayload(DragKind Kind, Method Method = default, LabChemicalDto? Chemical = null, int EductIndex = -1);

    private record MixSlotContent(DragKind Kind, string Label, int EductIndex = -1, Method Method = default, LabChemicalDto? Chemical = null);

    private Dictionary<int, string> _answers = new();
    private Dictionary<int, bool> _answerResults = new();
    private bool _hasChecked;

    private Dictionary<int, HashSet<Method>> _revealedMethods = new();
    private readonly List<ActionLogEntry> _actionLog = [];

    private bool _toolsPanelOpen;

    private DragPayload _drag;
    private int _dragOverEductIndex = -1;

    private MixSlotContent? _mixSlot1;
    private MixSlotContent? _mixSlot2;
    private int _mixDragOverSlot;
    private int _mixDragSource;
    private string? _mixError;

    protected override void OnParametersSet()
    {
        _answers = new Dictionary<int, string>();
        _answerResults = new Dictionary<int, bool>();
        _revealedMethods = new Dictionary<int, HashSet<Method>>();
        for (var i = 0; i < Question.UnknownEducts.Count; i++)
        {
            _answers[i] = "";
            _revealedMethods[i] = [];
        }
        _actionLog.Clear();
        _hasChecked = false;
        _toolsPanelOpen = false;
        _mixError = null;
        ClearMixSlots();
        _drag = default;
    }

    private string GetAnswerResultClass(int idx)
    {
        if (_hasChecked && _answerResults.TryGetValue(idx, out var isCorrect))
            return isCorrect ? "border-success" : "border-danger";
        return "";
    }

    private void CheckAnswers()
    {
        for (var i = 0; i < Question.UnknownEducts.Count; i++)
        {
            var actual = Question.UnknownEducts[i];
            var entered = _answers.GetValueOrDefault(i, "").Trim();
            _answerResults[i] = MatchesFormula(entered, actual);
        }
        _hasChecked = true;
    }

    private void RetryQuestion()
    {
        _hasChecked = false;
        _answerResults.Clear();
    }

    private Task Continue()
    {
        var formulas = Enumerable.Range(0, Question.UnknownEducts.Count)
            .Select(i => _answers.GetValueOrDefault(i, "").Trim())
            .ToList();
        var allCorrect = _answerResults.Values.All(r => r == true);
        var correctCount = _answerResults.Values.Count(r => r == true);
        return OnAnswered.InvokeAsync(new SpotTestAnswered
        {
            ChemicalFormulas = formulas,
            AllCorrect = allCorrect,
            CorrectCount = correctCount,
            TotalCount = Question.UnknownEducts.Count
        });
    }

    private void StartDragMethod(Method method) =>
        _drag = new DragPayload(DragKind.Method, Method: method);

    private void StartDragChemical(LabChemicalDto chem) =>
        _drag = new DragPayload(DragKind.Chemical, Chemical: chem);

    private void StartDragEduct(int index) =>
        _drag = new DragPayload(DragKind.Educt, EductIndex: index);

    private void HandleDropOnEduct(int targetIndex)
    {
        _dragOverEductIndex = -1;
        if (_hasChecked)
        {
            _drag = default;
            return;
        }

        switch (_drag.Kind)
        {
            case DragKind.Method:
            {
                _revealedMethods[targetIndex].Add(_drag.Method);
                var educt = Question.UnknownEducts[targetIndex];
                var colorDto = educt.MethodOutputs.GetValueOrDefault(_drag.Method);
                _actionLog.Add(new ActionLogEntry { Left = $"Educt {targetIndex + 1}", Right = _drag.Method.ToString(), Result = colorDto?.Name ?? "none" });
                break;
            }
            case DragKind.Chemical when _drag.Chemical != null:
            {
                var educt = Question.UnknownEducts[targetIndex];
                var reaction = FindReaction(educt.ChemicalId, _drag.Chemical.ChemicalId);
                _actionLog.Add(new ActionLogEntry
                {
                    Left = $"Educt {targetIndex + 1}",
                    Right = _drag.Chemical.Name,
                    Result = reaction?.ObservationDescription ?? "No reaction"
                });
                break;
            }
            case DragKind.Educt:
            {
                if (_drag.EductIndex == targetIndex)
                {
                    _drag = default;
                    return;
                }

                var left = Question.UnknownEducts[_drag.EductIndex];
                var right = Question.UnknownEducts[targetIndex];
                var reaction = FindReaction(left.ChemicalId, right.ChemicalId);
                _actionLog.Add(new ActionLogEntry
                {
                    Left = $"Educt {_drag.EductIndex + 1}",
                    Right = $"Educt {targetIndex + 1}",
                    Result = reaction?.ObservationDescription ?? "No reaction"
                });
                break;
            }
        }

        _drag = default;
    }

    private void MixDropOutside()
    {
        if (_mixDragSource == 1) _mixSlot1 = null;
        if (_mixDragSource == 2) _mixSlot2 = null;
        _mixDragSource = 0; _mixDragOverSlot = 0;
    }

    private MixSlotContent? MixSlotFromDrag() => _drag.Kind switch
    {
        DragKind.Educt => new MixSlotContent(DragKind.Educt, $"Educt {_drag.EductIndex + 1}", EductIndex: _drag.EductIndex),
        DragKind.Method => new MixSlotContent(DragKind.Method, _drag.Method.ToString(), Method: _drag.Method),
        DragKind.Chemical when _drag.Chemical != null => new MixSlotContent(DragKind.Chemical, _drag.Chemical.Name, Chemical: _drag.Chemical),
        _ => null
    };

    private void MixDrop(int slot)
    {
        _mixDragOverSlot = 0;
        if (_mixDragSource == 1) _mixSlot1 = null;
        if (_mixDragSource == 2) _mixSlot2 = null;
        _mixDragSource = 0;
        if (_drag.Kind == DragKind.None) return;

        var content = MixSlotFromDrag();
        if (content == null) return;

        if (slot == 1)
            _mixSlot1 = content;
        else
            _mixSlot2 = content;

        _drag = default;
    }

    private void ExecuteMix()
    {
        if (_mixSlot1 is not { } slot1 || _mixSlot2 is not { } slot2) return;
        _mixError = null;

        switch (slot1.Kind, slot2.Kind)
        {
            case (DragKind.Educt, DragKind.Educt):
            {
                if (slot1.EductIndex == slot2.EductIndex)
                {
                    _mixError = "You cannot mix an educt with itself.";
                    return;
                }

                var left = Question.UnknownEducts[slot1.EductIndex];
                var right = Question.UnknownEducts[slot2.EductIndex];
                var reaction = FindReaction(left.ChemicalId, right.ChemicalId);
                _actionLog.Add(new ActionLogEntry
                {
                    Left = $"Educt {slot1.EductIndex + 1}",
                    Right = $"Educt {slot2.EductIndex + 1}",
                    Result = reaction?.ObservationDescription ?? "No reaction"
                });
                break;
            }
            case (DragKind.Educt, DragKind.Chemical) when slot2.Chemical != null:
            {
                var educt = Question.UnknownEducts[slot1.EductIndex];
                var reaction = FindReaction(educt.ChemicalId, slot2.Chemical.ChemicalId);
                _actionLog.Add(new ActionLogEntry
                {
                    Left = $"Educt {slot1.EductIndex + 1}",
                    Right = slot2.Chemical.Name,
                    Result = reaction?.ObservationDescription ?? "No reaction"
                });
                break;
            }
            case (DragKind.Educt, DragKind.Method):
                ApplyMethodToEduct(slot1.EductIndex, slot2.Method);
                break;
            case (DragKind.Method, DragKind.Educt):
                ApplyMethodToEduct(slot2.EductIndex, slot1.Method);
                break;
            default:
                _mixError = "This combination is not possible.";
                break;
        }
    }

    private void ApplyMethodToEduct(int eductIdx, Method method)
    {
        _revealedMethods[eductIdx].Add(method);
        var educt = Question.UnknownEducts[eductIdx];
        var colorDto = educt.MethodOutputs.GetValueOrDefault(method);
        _actionLog.Add(new ActionLogEntry { Left = $"Educt {eductIdx + 1}", Right = method.ToString(), Result = colorDto?.Name ?? "none" });
    }

    private void ClearMixSlots()
    {
        _mixSlot1 = null;
        _mixSlot2 = null;
        _mixDragOverSlot = 0;
        _mixError = null;
    }

    private LabReactionDto? FindReaction(int c1, int c2) =>
        AllReactions.FirstOrDefault(r =>
            (r.Chemical1ID == c1 && r.Chemical2ID == c2) ||
            (r.Chemical1ID == c2 && r.Chemical2ID == c1));

    private static bool MatchesFormula(string input, LabChemicalDto chemical)
    {
        if (string.IsNullOrWhiteSpace(input)) return false;
        var n = NormalizeFormula(input);
        return n == NormalizeFormula(chemical.Formula) || n == NormalizeFormula(chemical.Name);
    }

    private static string NormalizeFormula(string formula) => formula.Trim().ToLowerInvariant()
        .Replace("₀", "0").Replace("₁", "1").Replace("₂", "2").Replace("₃", "3")
        .Replace("₄", "4").Replace("₅", "5").Replace("₆", "6").Replace("₇", "7")
        .Replace("₈", "8").Replace("₉", "9");

    public class SpotTestAnswered
    {
        public List<string> ChemicalFormulas { get; init; } = [];
        public bool AllCorrect { get; init; }
        public int CorrectCount { get; init; }
        public int TotalCount { get; init; }
    }

    private class ActionLogEntry
    {
        public string Left { get; init; } = "";
        public string Right { get; init; } = "";
        public string Result { get; init; } = "";
    }
}
