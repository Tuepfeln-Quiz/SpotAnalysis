<div class="d-flex justify-content-between align-items-baseline gap-2">
    <strong>@Chemical.Name</strong>
    <span class="text-muted"><ChemFormula Value="@Chemical.Formula" /></span>
</div>

@{
    var eigenfarbe = string.IsNullOrWhiteSpace(Chemical.Color?.Name) ? null : Chemical.Color;
    var flame = Chemical.MethodOutputs.GetValueOrDefault(Method.FlameColoration);
    var phPaper = Chemical.MethodOutputs.GetValueOrDefault(Method.PhPaper);
}
@if (eigenfarbe != null || flame != null || phPaper != null)
{
    <div class="d-flex flex-wrap gap-2 mt-1">
        @if (eigenfarbe != null)
        {
            <small title="Eigenfarbe" style="color: @eigenfarbe.HexValue;"><strong>
                    <TestTubeIcon/> @eigenfarbe.Name</strong></small>
        }
        @if (flame != null)
        {
            <small title="Flammenfärbung" style="color: @flame.HexValue;"><strong>
                    <FlameIcon/> @flame.Name</strong></small>
        }
        @if (phPaper != null)
        {
            <small title="pH-Papier Färbung" style="color: @phPaper.HexValue;"><strong>
                    <PhPaperIcon/> @phPaper.Name</strong></small>
        }
    </div>
}

@TrailingContent

@code {
    [Parameter] public LabChemicalDto Chemical { get; set; } = default!;
    [Parameter] public RenderFragment? TrailingContent { get; set; }
}
