@page "/profile"
@page "/reset-password"
@attribute [Authorize]
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Profil – SpotAnalysis</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-teal-50 p-8">
    <div class="mx-auto max-w-3xl rounded-3xl bg-white p-8 shadow-xl">
        <div class="mb-8 flex items-center gap-4">
            <div class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-teal-100 to-blue-100 text-4xl">
                🧑‍🔬
            </div>
            <div>
                <p class="text-sm font-medium text-teal-600">Profil & Passwort</p>
                <h1 class="text-3xl font-bold text-gray-800">Konto verwalten</h1>
                <p class="mt-1 text-sm text-gray-500">Benutzername ändern und Passwort zurücksetzen.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div
                class="mb-6 rounded-2xl border @(_isError ? "border-red-200 bg-red-50 text-red-700" : "border-green-200 bg-green-50 text-green-700") px-4 py-3 text-sm">
                @_message
            </div>
        }

        <div class="space-y-8">
            <EditForm Model="@UsernameModel" OnValidSubmit="HandleUsernameUpdate" FormName="UsernameForm">
                <DataAnnotationsValidator/>
                <div class="rounded-2xl border border-gray-100 bg-gray-50/50 p-5">
                    <label class="mb-2 block text-sm font-medium text-gray-700">Benutzername</label>
                    <div class="flex gap-3">
                        <InputText @bind-Value="UsernameModel.NewUsername"
                                   class="flex-1 rounded-2xl border border-gray-300 px-4 py-3 outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100"/>
                        <button type="submit"
                                class="rounded-2xl bg-teal-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-teal-200 hover:bg-teal-600">
                            Speichern
                        </button>
                    </div>
                    <ValidationMessage For="() => UsernameModel.NewUsername" class="mt-1 text-xs text-red-500"/>
                </div>
            </EditForm>

            <EditForm Model="@PasswordModel" OnValidSubmit="HandlePasswordUpdate" FormName="PasswordForm">
                <DataAnnotationsValidator/>
                <div class="rounded-2xl border border-gray-100 bg-gray-50/50 p-5 space-y-4">
                    <h2 class="text-sm font-medium text-gray-700">Passwort ändern</h2>

                    <div>
                        <label class="mb-1 block text-xs font-medium text-gray-500">Aktuelles Passwort</label>
                        <InputText type="password" @bind-Value="PasswordModel.OldPassword"
                                   class="w-full rounded-2xl border border-gray-300 px-4 py-3 outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100"/>
                        <ValidationMessage For="() => PasswordModel.OldPassword" class="mt-1 text-xs text-red-500"/>
                    </div>

                    <div>
                        <label class="mb-1 block text-xs font-medium text-gray-500">Neues Passwort</label>
                        <InputText type="password" @bind-Value="PasswordModel.NewPassword"
                                   class="w-full rounded-2xl border border-gray-300 px-4 py-3 outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100"/>
                        <ValidationMessage For="() => PasswordModel.NewPassword" class="mt-1 text-xs text-red-500"/>
                    </div>

                    <div>
                        <label class="mb-1 block text-xs font-medium text-gray-500">Passwort wiederholen</label>
                        <InputText type="password" @bind-Value="PasswordModel.ConfirmPassword"
                                   class="w-full rounded-2xl border border-gray-300 px-4 py-3 outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100"/>
                        <ValidationMessage For="() => PasswordModel.ConfirmPassword" class="mt-1 text-xs text-red-500"/>
                    </div>

                    <div class="flex justify-end pt-1">
                        <button type="submit"
                                class="rounded-2xl bg-teal-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-teal-200 hover:bg-teal-600">
                            Passwort ändern
                        </button>
                    </div>
                </div>
            </EditForm>

            <div class="flex justify-end pt-2">
                <a href="/"
                   class="rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50">Zurück</a>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private Guid _userId;
    private string? _message;
    private bool _isError;

    private UsernameFormModel UsernameModel { get; set; } = new();

    private PasswordFormModel PasswordModel { get; set; } = new();

    public class UsernameFormModel
    {
        [Required(ErrorMessage = "Der Benutzername darf nicht leer sein.")]
        [MaxLength(128, ErrorMessage = "Der Benutzername darf maximal 128 Zeichen lang sein.")]
        public string NewUsername { get; set; } = string.Empty;
    }

    public class PasswordFormModel
    {
        [Required(ErrorMessage = "Aktuelles Passwort ist erforderlich.")]
        public string OldPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Neues Passwort ist erforderlich.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z\d]).{8,}$",
            ErrorMessage = "Mindestens 8 Zeichen mit Großbuchstabe, Kleinbuchstabe, Zahl und Sonderzeichen.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Passwort-Bestätigung ist erforderlich.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        var user = authState.User;

        if (string.IsNullOrEmpty(UsernameModel.NewUsername))
            UsernameModel.NewUsername = user.Identity?.Name ?? string.Empty;

        var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(idClaim, out var parsed))
            _userId = parsed;
    }

    private async Task HandleUsernameUpdate()
    {
        try
        {
            await UserService.UpdateUsername(_userId, UsernameModel.NewUsername.Trim());
            SetMessage("Benutzername erfolgreich aktualisiert.", false);
        }
        catch (InvalidOperationException ex)
        {
            SetMessage(ex.Message switch
            {
                "Username taken" => "Dieser Benutzername ist bereits vergeben.",
                _ => "Benutzername konnte nicht aktualisiert werden."
            }, true);
        }
    }

    private async Task HandlePasswordUpdate()
    {
        try
        {
            await UserService.ChangePassword(_userId, PasswordModel.OldPassword, PasswordModel.NewPassword);
            PasswordModel = new PasswordFormModel();
            SetMessage("Passwort erfolgreich geändert.", false);
        }
        catch (InvalidOperationException ex)
        {
            SetMessage(ex.Message switch
            {
                "WrongOldPassword" => "Das aktuelle Passwort ist falsch.",
                _ => "Passwort konnte nicht geändert werden."
            }, true);
        }
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _isError = isError;
    }
}
