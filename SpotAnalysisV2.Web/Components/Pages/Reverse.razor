@page "/reverse"
@attribute [Authorize]
@inject IChemistryDataService ChemistryData

<div class="size-full flex flex-col bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm px-6 h-24 flex items-center justify-between">
        <!-- Left - Home Button -->
        <NavLink href="/" class="flex items-center p-2 hover:bg-gray-100 rounded-lg transition-colors">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
        </NavLink>

        <!-- Center - Navigation Buttons -->
        <ExperimentTabs ActiveTab="reverse" ActiveTabClass="bg-purple-500 text-white" />

        <!-- Right - Profile -->
        <ProfileMenu ContainerClass="ml-auto" />
    </header>

    <!-- Main Content -->
    <div class="flex-1 flex overflow-hidden">
        <div class="flex-1 p-4 flex flex-col gap-4 overflow-y-auto hide-scrollbar">
            @if (currentChallenge != null)
            {
                <!-- Challenge Card -->
                <div class="bg-white rounded-xl shadow-md p-4">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center">
                            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-gray-800">Welches ist das 2. Element?</h2>
                            <p class="text-xs text-gray-500">Finden Sie das fehlende Element anhand der 3 Hinweise</p>
                        </div>
                    </div>

                    <!-- Element 1 (shown) + Element 2 (hidden) -->
                    <div class="grid grid-cols-2 gap-3 mb-4">
                        <div class="flex flex-col">
                            <h3 class="text-xs font-medium text-gray-600 mb-1">Edukt 1</h3>
                            <div
                                style="background-color: @(currentChallenge.Educt1.CardColorHex)1a; border-color: @(currentChallenge.Educt1.CardColorHex)80"
                                class="border-2 rounded-lg p-3 min-h-[120px] flex flex-col justify-center flex-1">
                                <p class="font-bold text-base">@currentChallenge.Educt1.Name</p>
                                <p class="text-xs text-gray-700 mb-2">@currentChallenge.Educt1.Type</p>
                                <div class="grid grid-cols-3 gap-1.5">
                                    <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                 style="color: @currentChallenge.Educt1.PhLevel.HexValue">
                                                <circle cx="12" cy="12" r="8" />
                                            </svg>
                                            <span
                                                class="text-[11px] font-medium text-gray-700 leading-tight">pH: @currentChallenge.Educt1.PhLevel.Name</span>
                                        </div>
                                        <div
                                            style="background-color: @currentChallenge.Educt1.PhLevel.HexValue"
                                            class="h-2.5 rounded border border-gray-400"></div>
                                    </div>
                                    <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                 style="color: @currentChallenge.Educt1.FlameColor.HexValue">
                                                <path d="M12 2C12 2 6 8 6 13c0 3.3 2.7 6 6 6s6-2.7 6-6c0-5-6-11-6-11zm0 16c-1.6 0-3-1.4-3-3 0-1.8 1.5-3.5 3-5.1 1.5 1.6 3 3.3 3 5.1 0 1.6-1.4 3-3 3z"/>
                                            </svg>
                                            <span
                                                class="text-[11px] font-medium text-gray-700 leading-tight">Flamme: @currentChallenge.Educt1.FlameColor.Name</span>
                                        </div>
                                        <div
                                            style="background-color: @currentChallenge.Educt1.FlameColor.HexValue"
                                            class="h-2.5 rounded border border-gray-400"></div>
                                    </div>
                                    <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                 style="color: @currentChallenge.Educt1.ElementColor.HexValue">
                                                <circle cx="12" cy="12" r="8" />
                                            </svg>
                                            <span
                                                class="text-[11px] font-medium text-gray-700 leading-tight">Farbe: @currentChallenge.Educt1.ElementColor.Name</span>
                                        </div>
                                        <div
                                            style="background-color: @currentChallenge.Educt1.ElementColor.HexValue"
                                            class="h-2.5 rounded border border-gray-400"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-col">
                            <h3 class="text-xs font-medium text-gray-600 mb-1">Edukt 2</h3>
                            <div
                                style="background-color: @(currentChallenge.Educt2.CardColorHex)1a; border-color: @(currentChallenge.Educt2.CardColorHex)80"
                                class="border-2 rounded-lg p-3 min-h-[120px] flex flex-col justify-center flex-1">
                                <p class="font-bold text-base mb-1">@currentChallenge.Educt2.Name</p>
                                <p class="text-xs text-gray-700 mb-2">@currentChallenge.Educt2.Type</p>
                                <div class="grid grid-cols-3 gap-1.5">
                                    <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                 style="color: @currentChallenge.Educt2.PhLevel.HexValue">
                                                <circle cx="12" cy="12" r="8" />
                                            </svg>
                                            <span
                                                class="text-[11px] font-medium text-gray-700 leading-tight">pH: @currentChallenge.Educt2.PhLevel.Name</span>
                                        </div>
                                        <div
                                            style="background-color: @currentChallenge.Educt2.PhLevel.HexValue"
                                            class="h-2.5 rounded border border-gray-400"></div>
                                    </div>
                                    <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                 style="color: @currentChallenge.Educt2.FlameColor.HexValue">
                                                <path d="M12 2C12 2 6 8 6 13c0 3.3 2.7 6 6 6s6-2.7 6-6c0-5-6-11-6-11zm0 16c-1.6 0-3-1.4-3-3 0-1.8 1.5-3.5 3-5.1 1.5 1.6 3 3.3 3 5.1 0 1.6-1.4 3-3 3z"/>
                                            </svg>
                                            <span
                                                class="text-[11px] font-medium text-gray-700 leading-tight">Flamme: @currentChallenge.Educt2.FlameColor.Name</span>
                                        </div>
                                        <div
                                            style="background-color: @currentChallenge.Educt2.FlameColor.HexValue"
                                            class="h-2.5 rounded border border-gray-400"></div>
                                    </div>
                                    <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                        <div class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                 style="color: @currentChallenge.Educt2.ElementColor.HexValue">
                                                <circle cx="12" cy="12" r="8" />
                                            </svg>
                                            <span
                                                class="text-[11px] font-medium text-gray-700 leading-tight">Farbe: @currentChallenge.Educt2.ElementColor.Name</span>
                                        </div>
                                        <div
                                            style="background-color: @currentChallenge.Educt2.ElementColor.HexValue"
                                            class="h-2.5 rounded border border-gray-400"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3 Input Fields -->
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Produkt</label>
                            <input type="text"
                                   value="@inputProdukt"
                                   @oninput="@((ChangeEventArgs e) => inputProdukt = e.Value?.ToString() ?? "")"
                                   disabled="@submitted"
                                   placeholder="z.B. H₂O"
                                   class="w-full px-3 py-2 border-2 border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" />
                            @if (submitted)
                            {
                                <p class="@(NormalizeString(inputProdukt) == NormalizeString(currentChallenge.Product.Name) ? "text-green-600" : "text-red-600") text-xs mt-1">
                                    @if (NormalizeString(inputProdukt) == NormalizeString(currentChallenge.Product.Name))
                                    {
                                        <span>✓ Richtig</span>
                                    }
                                    else
                                    {
                                        <span>✗ @currentChallenge.Product.Name</span>
                                    }
                                </p>
                            }
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Formel</label>
                            <input type="text"
                                   value="@inputFormel"
                                   @oninput="@((ChangeEventArgs e) => inputFormel = e.Value?.ToString() ?? "")"
                                   disabled="@submitted"
                                   placeholder="z.B. 2H₂ + O₂ → 2H₂O"
                                   class="w-full px-3 py-2 border-2 border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" />
                            @if (submitted)
                            {
                                <p class="@(NormalizeString(inputFormel) == NormalizeString(currentChallenge.Formula) ? "text-green-600" : "text-red-600") text-xs mt-1">
                                    @if (NormalizeString(inputFormel) == NormalizeString(currentChallenge.Formula))
                                    {
                                        <span>✓ Richtig</span>
                                    }
                                    else
                                    {
                                        <span>✗ @currentChallenge.Formula</span>
                                    }
                                </p>
                            }
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Beobachtung</label>
                            <input type="text"
                                   value="@inputBeobachtung"
                                   @oninput="@((ChangeEventArgs e) => inputBeobachtung = e.Value?.ToString() ?? "")"
                                   disabled="@submitted"
                                   placeholder="z.B. Knallgasreaktion"
                                   class="w-full px-3 py-2 border-2 border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-500" />
                            @if (submitted)
                            {
                                <p class="text-xs mt-1 text-gray-500">@currentChallenge.Observation</p>
                            }
                        </div>
                    </div>

                    <!-- Hint -->
                    @if (showHint && !submitted)
                    {
                        <div class="mt-3 p-2 bg-yellow-50 border border-yellow-200 rounded-lg text-xs text-yellow-800">
                            <span class="font-medium">Hinweis:</span> Das gesuchte Element ist vom Typ
                            „@currentChallenge.Educt2.Type" und hat die Flammenfarbe
                            „@currentChallenge.Educt2.FlameColor.Name".
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="flex gap-3 mt-3">
                        @if (!submitted)
                        {
                            <button @onclick="HandleCheck"
                                    disabled="@(!CanCheck())"
                                    class="@(!CanCheck() ? "bg-gray-200 text-gray-400 cursor-not-allowed" : "bg-purple-500 text-white hover:bg-purple-600") flex-1 py-3 rounded-lg font-medium transition-colors flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                                </svg>
                                Antwort Prüfen
                            </button>
                            <button @onclick="@(() => showHint = true)"
                                    disabled="@showHint"
                                    class="@(showHint ? "bg-gray-200 text-gray-400 cursor-not-allowed" : "bg-yellow-100 text-yellow-700 hover:bg-yellow-200") px-5 py-3 rounded-lg font-medium transition-colors flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Hinweis
                            </button>
                            <button @onclick="GenerateNewChallenge"
                                    class="px-5 py-3 rounded-lg font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                Überspringen
                            </button>
                        }
                        else if (lastResult.HasValue && lastResult.Value.IsCorrect)
                        {
                            <button @onclick="GenerateNewChallenge"
                                    class="flex-1 py-3 rounded-lg font-medium bg-green-500 text-white hover:bg-green-600 transition-colors flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                Nächste Herausforderung
                            </button>
                        }
                        else
                        {
                            <button @onclick="HandleRetry"
                                    class="flex-1 py-3 rounded-lg font-medium bg-purple-500 text-white hover:bg-purple-600 transition-colors flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                Nochmal versuchen
                            </button>
                            <button @onclick="GenerateNewChallenge"
                                    class="px-5 py-3 rounded-lg font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors flex items-center gap-2">
                                Überspringen
                            </button>
                        }
                    </div>
                    @if (attempts > 0)
                    {
                        <p class="text-xs text-gray-400 mt-2 text-center">Versuche: @attempts</p>
                    }
                </div>
            }

            <!-- Guess History -->
            <div class="flex-1">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-base font-semibold flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                        </svg>
                        Vermutungshistorie
                    </h2>

                    <button @onclick="ToggleGuessHistory"
                            class="p-2 rounded-lg border border-gray-200 bg-white text-gray-600 hover:bg-gray-50"
                            title="Historie anzeigen/ausblenden"
                            aria-label="Historie anzeigen oder ausblenden">
                        @if (isGuessHistoryVisible)
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        }
                    </button>
                </div>

                @if (currentGuessLog == null && guessLogs.Count == 0)
                {
                    <div class="bg-white rounded-lg shadow-md p-8 text-center text-gray-400">
                        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                        </svg>
                        <p>Noch keine Vermutungen. Füllen Sie die 3 Felder aus und prüfen Sie!</p>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var log in (isGuessHistoryVisible
                            ? GetVisibleGuessLogs()
                            : (currentGuessLog is null ? Enumerable.Empty<GuessLog>() : [currentGuessLog])))
                        {
                            <div class="@(log.IsCorrect ? "border-green-400" : "border-red-400") bg-white rounded-lg shadow-md p-4 border-2">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex-1">
                                        <div class="flex items-center justify-between gap-2 mb-3">
                                            <div class="flex items-center gap-2">
                                                <div
                                                    style="background-color: @(log.Challenge.Educt1.CardColorHex)1a; border-color: @(log.Challenge.Educt1.CardColorHex)80"
                                                    class="border-2 rounded px-3 py-1">
                                                    <p class="text-sm font-bold">@log.Challenge.Educt1.Name</p>
                                                </div>
                                                <span class="font-bold text-gray-600">+</span>
                                                <div
                                                    style="background-color: @(log.Challenge.Educt2.CardColorHex)1a; border-color: @(log.Challenge.Educt2.CardColorHex)80"
                                                    class="border-2 rounded px-3 py-1">
                                                    <p class="text-sm font-bold">@log.Challenge.Educt2.Name</p>
                                                </div>
                                                <span class="font-bold text-gray-600">→</span>
                                                <div
                                                    style="background-color: @(log.Challenge.Product.CardColorHex)1a; border-color: @(log.Challenge.Product.CardColorHex)80"
                                                    class="border-2 rounded px-3 py-1">
                                                    <p class="text-sm font-bold">@log.Challenge.Product.Name</p>
                                                </div>
                                            </div>

                                            @if (IsCurrentGuess(log))
                                            {
                                                <span class="text-[11px] px-2 py-1 rounded-full bg-purple-100 text-purple-700 font-medium">Aktuell</span>
                                            }
                                            else
                                            {
                                                <span class="text-[11px] px-2 py-1 rounded-full bg-gray-100 text-gray-600 font-medium">Historie</span>
                                            }
                                        </div>

                                        <div class="grid grid-cols-3 gap-2 text-xs">
                                            <div class="bg-gray-50 p-2 rounded">
                                                <p class="text-gray-500 font-medium">Produkt</p>
                                                <p class="font-medium">@log.UserProduct</p>
                                            </div>
                                            <div class="bg-gray-50 p-2 rounded">
                                                <p class="text-gray-500 font-medium">Formel</p>
                                                <p class="font-medium">@log.UserFormula</p>
                                            </div>
                                            <div class="bg-gray-50 p-2 rounded">
                                                <p class="text-gray-500 font-medium">Beobachtung</p>
                                                <p class="font-medium">@log.UserObservation</p>
                                            </div>
                                        </div>
                                        <p class="text-xs text-gray-400 mt-2">@log.Timestamp.ToString("HH:mm:ss")</p>
                                    </div>

                                    <div class="flex items-center justify-center">
                                        <div
                                            class="group relative w-32 h-32 bg-white/50 rounded-lg border-2 border-gray-200 flex items-center justify-center flex-shrink-0 cursor-pointer hover:shadow-lg transition-all duration-200 @(!string.IsNullOrEmpty(log.Challenge.Product.ImageUrl) ? "reverse-image-tile-has-image" : string.Empty)">
                                            @if (!string.IsNullOrEmpty(log.Challenge.Product.ImageUrl))
                                            {
                                                <img src="@log.Challenge.Product.ImageUrl"
                                                     alt="@log.Challenge.Product.Name"
                                                     class="h-full object-contain p-2"/>
                                                <div class="fixed inset-0 z-[9999] hidden items-center justify-center pointer-events-none group-hover:flex">
                                                    <div class="w-[600px] h-[600px] bg-white rounded-lg shadow-2xl border-2 border-gray-300 p-3 flex items-center justify-center">
                                                        <img src="@log.Challenge.Product.ImageUrl"
                                                             alt="@log.Challenge.Product.Name"
                                                             class="h-full object-contain"/>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                <div class="fixed inset-0 z-[9999] hidden items-center justify-center pointer-events-none group-hover:flex">
                                                    <div class="w-[600px] h-[600px] bg-white rounded-lg shadow-2xl border-2 border-gray-300 p-3 flex items-center justify-center">
                                                        <svg class="w-56 h-56 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                        </svg>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!isGuessHistoryVisible && guessLogs.Count > 0)
                        {
                            <div class="text-center text-xs text-gray-500">
                                @guessLogs.Count ältere Einträge ausgeblendet
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {

    private class EductVm
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Type { get; set; }
        public string CardColorHex { get; set; } = "#666666";
        public ColorInfo PhLevel { get; set; } = new("-", "#9ca3af");
        public ColorInfo FlameColor { get; set; } = new("Keine", "#9ca3af");
        public ColorInfo ElementColor { get; set; } = new("", "#9ca3af");
        public string ImageUrl { get; set; }
    }

    private class ProductVm
    {
        public string Name { get; set; }
        public string CardColorHex { get; set; } = "#666666";
        public string ImageUrl { get; set; }
    }

    private class Challenge
    {
        public EductVm Educt1 { get; set; }
        public EductVm Educt2 { get; set; }
        public ProductVm Product { get; set; }
        public string Formula { get; set; }
        public string Observation { get; set; }
    }

    private class GuessLog
    {
        public string Id { get; set; }
        public Challenge Challenge { get; set; }
        public string UserProduct { get; set; }
        public string UserFormula { get; set; }
        public string UserObservation { get; set; }
        public bool IsCorrect { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private List<Challenge> challenges = [];
    private Challenge currentChallenge;
    private string inputProdukt = "";
    private string inputFormel = "";
    private string inputBeobachtung = "";
    private GuessLog? currentGuessLog;
    private readonly List<GuessLog> guessLogs = new();
    private bool showHint = false;
    private bool submitted = false;
    private bool isGuessHistoryVisible = false;
    private (bool IsCorrect, EductVm CorrectElement)? lastResult = null;
    private int attempts = 0;
    private readonly Random random = new();

    protected override async Task OnInitializedAsync()
    {
        var chemicals = await ChemistryData.GetAllChemicalsAsync();
        var reactions = await ChemistryData.GetAllReactionsAsync();
        var chemDict = chemicals.ToDictionary(c => c.ChemicalID, MapChemical);

        challenges = reactions
            .Where(r => chemDict.ContainsKey(r.Chemical1ID) && chemDict.ContainsKey(r.Chemical2ID))
            .Select(r => new Challenge
            {
                Educt1 = chemDict[r.Chemical1ID],
                Educt2 = chemDict[r.Chemical2ID],
                Product = new ProductVm
                {
                    Name = r.RelevantProduct,
                    CardColorHex = "#666666",
                    ImageUrl = r.ImagePath ?? ""
                },
                Formula = r.Formula,
                Observation = r.ObservationDescription,
            })
            .ToList();

        isGuessHistoryVisible = false;
        GenerateNewChallenge();
    }

    private static EductVm MapChemical(LabChemicalDto c)
    {
        return new EductVm
        {
            Id = c.ChemicalID,
            Name = c.Name,
            Type = c.Formula,
            CardColorHex = c.Color.HexValue,
            PhLevel = ExtractMethodColor(c.MethodOutputs, "pH-Papier"),
            FlameColor = ExtractMethodColor(c.MethodOutputs, "Flammenfärbung"),
            ElementColor = new ColorInfo(c.Color.Name, c.Color.HexValue),
            ImageUrl = c.ImagePath ?? ""
        };
    }

    private static ColorInfo ExtractMethodColor(Dictionary<string, ColorDto> outputs, string key)
    {
        foreach (var k in outputs.Keys)
        {
            if (string.Equals(k, key, StringComparison.OrdinalIgnoreCase) && outputs.TryGetValue(k, out var color))
                return new ColorInfo(color.Name, color.HexValue);
        }

        return new ColorInfo("-", "#9ca3af");
    }

    private void GenerateNewChallenge()
    {
        if (challenges.Count == 0) return;
        currentChallenge = challenges[random.Next(challenges.Count)];
        inputProdukt = "";
        inputFormel = "";
        inputBeobachtung = "";
        showHint = false;
        submitted = false;
        lastResult = null;
        attempts = 0;
        StateHasChanged();
    }

    private bool CanCheck()
    {
        return !string.IsNullOrWhiteSpace(inputProdukt)
            && !string.IsNullOrWhiteSpace(inputFormel)
            && !string.IsNullOrWhiteSpace(inputBeobachtung);
    }

    private void HandleCheck()
    {
        if (!CanCheck() || currentChallenge == null) return;

        bool produktMatch = NormalizeString(inputProdukt) == NormalizeString(currentChallenge.Product.Name);
        bool formelMatch = NormalizeString(inputFormel) == NormalizeString(currentChallenge.Formula);
        bool isCorrect = produktMatch && formelMatch;

        attempts++;
        submitted = true;
        lastResult = (isCorrect, currentChallenge.Educt2);

        if (isCorrect)
        {
            var newLog = new GuessLog
            {
                Id = DateTime.Now.Ticks.ToString(),
                Challenge = currentChallenge,
                UserProduct = inputProdukt,
                UserFormula = inputFormel,
                UserObservation = inputBeobachtung,
                IsCorrect = isCorrect,
                Timestamp = DateTime.Now
            };

            if (currentGuessLog != null)
                guessLogs.Insert(0, currentGuessLog);

            currentGuessLog = newLog;
        }

        StateHasChanged();
    }

    private void HandleRetry()
    {
        submitted = false;
        lastResult = null;
        StateHasChanged();
    }

    private void HandleDeleteLog(string logId)
    {
        if (currentGuessLog?.Id == logId)
        {
            currentGuessLog = guessLogs.Count > 0 ? guessLogs[0] : null;
            if (guessLogs.Count > 0) guessLogs.RemoveAt(0);
        }
        else
        {
            guessLogs.RemoveAll(l => l.Id == logId);
        }
        StateHasChanged();
    }

    private void ToggleGuessHistory()
    {
        isGuessHistoryVisible = !isGuessHistoryVisible;
    }

    private string NormalizeString(string s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        return s.ToLower()
            .Replace(" ", "")
            .Replace("₂", "2")
            .Replace("₃", "3")
            .Replace("₄", "4");
    }

    private bool IsCurrentGuess(GuessLog log) => currentGuessLog?.Id == log.Id;

    private IEnumerable<GuessLog> GetVisibleGuessLogs()
    {
        if (currentGuessLog != null)
            yield return currentGuessLog;
        foreach (var log in guessLogs)
            yield return log;
    }

    private sealed record ColorInfo(string Name, string HexValue);
}
