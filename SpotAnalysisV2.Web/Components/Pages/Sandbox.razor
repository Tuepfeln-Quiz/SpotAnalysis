@page "/sandbox"
@attribute [Authorize]
@inject IChemistryDataService ChemistryData

<div class="size-full flex flex-col bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm px-6 h-24 flex items-center justify-between">
        <!-- Left - Home Button -->
        <NavLink href="/" class="flex items-center p-2 hover:bg-gray-100 rounded-lg transition-colors">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
        </NavLink>

        <!-- Center - Navigation Buttons -->
        <ExperimentTabs ActiveTab="sandbox" ActiveTabClass="bg-blue-500 text-white" />

        <!-- Right - Profile -->
        <ProfileMenu ContainerClass="ml-auto" />
    </header>

    <!-- Main Content -->
    <div class="flex-1 flex overflow-hidden">
        <!-- Left Side - Workspace -->
        <div class="flex-1 p-6 flex flex-col gap-6 overflow-y-auto hide-scrollbar">
            <!-- Top - Drop Boxes -->
            <div>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <!-- Element 1 Drop Zone -->
                    <div @ondrop="@((DragEventArgs e) => HandleDrop(e, 1))"
                         @ondrop:preventDefault
                         @ondragover="HandleDragOver1"
                         @ondragover:preventDefault
                         @ondragleave="HandleDragLeave1">
                        <h3 class="text-sm font-medium mb-2">Edukt 1</h3>
                        <div
                            class="w-full border-2 border-dashed rounded-lg p-3 min-h-[140px] flex items-center justify-center transition-all text-left cursor-pointer @(isDragOver1 ? "bg-blue-100 border-blue-400" : "") @(_box1EductVm != null ? "sandbox-dropzone-filled" : "sandbox-dropzone-empty")"
                            @onclick="() => PlaceEduct(1)">
                            @if (_box1EductVm != null)
                            {
                                <div draggable="true"
                                     @ondragstart="@(() => HandleDragStart(_box1EductVm))"
                                     @ondragend="HandleDragEnd"
                                     style="background-color: @(_box1EductVm.CardColorHex)1a; border-color: @(_box1EductVm.CardColorHex)80"
                                     class="border-2 rounded-lg p-3 w-full cursor-grab">
                                    <p class="font-bold text-base mb-1">@_box1EductVm.Name</p>
                                    <p class="text-xs text-gray-700 mb-2">@_box1EductVm.Type</p>
                                    <div class="grid grid-cols-3 gap-1.5">
                                        <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                            <div class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                     style="color: @_box1EductVm.PhLevel.HexValue">
                                                    <circle cx="12" cy="12" r="8" />
                                                </svg>
                                                <span
                                                    class="text-[11px] font-medium text-gray-700 leading-tight">pH: @_box1EductVm.PhLevel.Name</span>
                                            </div>
                                            <div
                                                style="background-color: @_box1EductVm.PhLevel.HexValue"
                                                class="h-2.5 rounded border border-gray-400"></div>
                                        </div>
                                        <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                            <div class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                     style="color: @_box1EductVm.FlameColor.HexValue">
                                                    <path d="M12 2C12 2 6 8 6 13c0 3.3 2.7 6 6 6s6-2.7 6-6c0-5-6-11-6-11zm0 16c-1.6 0-3-1.4-3-3 0-1.8 1.5-3.5 3-5.1 1.5 1.6 3 3.3 3 5.1 0 1.6-1.4 3-3 3z"/>
                                                </svg>
                                                <span class="text-[11px] font-medium text-gray-700 leading-tight">Flamme: @_box1EductVm.FlameColor.Name</span>
                                            </div>
                                            <div
                                                style="background-color: @_box1EductVm.FlameColor.HexValue"
                                                class="h-2.5 rounded border border-gray-400"></div>
                                        </div>
                                        <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                            <div class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                     style="color: @_box1EductVm.ElementColor.HexValue">
                                                    <circle cx="12" cy="12" r="8" />
                                                </svg>
                                                <span
                                                    class="text-[11px] font-medium text-gray-700 leading-tight">Farbe: @_box1EductVm.ElementColor.Name</span>
                                            </div>
                                            <div
                                                style="background-color: @_box1EductVm.ElementColor.HexValue"
                                                class="h-2.5 rounded border border-gray-400"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <p class="text-gray-400 text-sm">@(_selectedEductVm != null || _draggedEductVm != null ? "Klick zum Platzieren oder Ziehen" : "Wählen Sie Element rechts")</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Element 2 Drop Zone -->
                    <div @ondrop="@((DragEventArgs e) => HandleDrop(e, 2))"
                         @ondrop:preventDefault
                         @ondragover="HandleDragOver2"
                         @ondragover:preventDefault
                         @ondragleave="HandleDragLeave2">
                        <h3 class="text-sm font-medium mb-2">Edukt 2</h3>
                        <div
                            class="w-full border-2 border-dashed rounded-lg p-3 min-h-[140px] flex items-center justify-center transition-all text-left cursor-pointer @(isDragOver2 ? "bg-blue-100 border-blue-400" : "") @(_box2EductVm != null ? "sandbox-dropzone-filled" : "sandbox-dropzone-empty")"
                            @onclick="() => PlaceEduct(2)">
                            @if (_box2EductVm != null)
                            {
                                <div draggable="true"
                                     @ondragstart="@(() => HandleDragStart(_box2EductVm))"
                                     @ondragend="HandleDragEnd"
                                     style="background-color: @(_box2EductVm.CardColorHex)1a; border-color: @(_box2EductVm.CardColorHex)80"
                                     class="border-2 rounded-lg p-3 w-full cursor-grab">
                                    <p class="font-bold text-base mb-1">@_box2EductVm.Name</p>
                                    <p class="text-xs text-gray-700 mb-2">@_box2EductVm.Type</p>
                                    <div class="grid grid-cols-3 gap-1.5">
                                        <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                            <div class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                     style="color: @_box2EductVm.PhLevel.HexValue">
                                                    <circle cx="12" cy="12" r="8" />
                                                </svg>
                                                <span
                                                    class="text-[11px] font-medium text-gray-700 leading-tight">pH: @_box2EductVm.PhLevel.Name</span>
                                            </div>
                                            <div
                                                style="background-color: @_box2EductVm.PhLevel.HexValue"
                                                class="h-2.5 rounded border border-gray-400"></div>
                                        </div>
                                        <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                            <div class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                     style="color: @_box2EductVm.FlameColor.HexValue">
                                                    <path d="M12 2C12 2 6 8 6 13c0 3.3 2.7 6 6 6s6-2.7 6-6c0-5-6-11-6-11zm0 16c-1.6 0-3-1.4-3-3 0-1.8 1.5-3.5 3-5.1 1.5 1.6 3 3.3 3 5.1 0 1.6-1.4 3-3 3z"/>
                                                </svg>
                                                <span class="text-[11px] font-medium text-gray-700 leading-tight">Flamme: @_box2EductVm.FlameColor.Name</span>
                                            </div>
                                            <div
                                                style="background-color: @_box2EductVm.FlameColor.HexValue"
                                                class="h-2.5 rounded border border-gray-400"></div>
                                        </div>
                                        <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                            <div class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                                     style="color: @_box2EductVm.ElementColor.HexValue">
                                                    <circle cx="12" cy="12" r="8" />
                                                </svg>
                                                <span
                                                    class="text-[11px] font-medium text-gray-700 leading-tight">Farbe: @_box2EductVm.ElementColor.Name</span>
                                            </div>
                                            <div
                                                style="background-color: @_box2EductVm.ElementColor.HexValue"
                                                class="h-2.5 rounded border border-gray-400"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <p class="text-gray-400 text-sm">@(_selectedEductVm != null || _draggedEductVm != null ? "Klick zum Platzieren oder Ziehen" : "Wählen Sie Element rechts")</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Mix and Clear Buttons -->
                <div class="flex gap-3">
                    <button @onclick="HandleMix"
                            disabled="@(_box1EductVm == null || _box2EductVm == null)"
                            class="@(_box1EductVm != null && _box2EductVm != null ? "flex-1 py-3 rounded-lg font-medium transition-colors flex items-center justify-center gap-2 bg-blue-500 text-white hover:bg-blue-600" : "flex-1 py-3 rounded-lg font-medium transition-colors flex items-center justify-center gap-2 bg-gray-200 text-gray-400 cursor-not-allowed")">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                        </svg>
                        Edukte Mischen
                    </button>
                    <button @onclick="HandleClear"
                            disabled="@(_box1EductVm == null && _box2EductVm == null)"
                            class="@(_box1EductVm != null || _box2EductVm != null ? "px-6 py-3 rounded-lg font-medium transition-colors bg-red-500 text-white hover:bg-red-600" : "px-6 py-3 rounded-lg font-medium transition-colors bg-gray-200 text-gray-400 cursor-not-allowed")">
                        Löschen
                    </button>
                </div>
            </div>

            <!-- Misch-Logs -->
            <div class="flex-1">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                        </svg>
                        Experimenthistorie (Misch-Logs)
                    </h2>

                    <button @onclick="ToggleHistory"
                            class="p-2 rounded-lg border border-gray-200 bg-white text-gray-600 hover:bg-gray-50"
                            title="Historie anzeigen/ausblenden"
                            aria-label="Historie anzeigen oder ausblenden">
                        @if (isHistoryVisible)
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        }
                    </button>
                </div>

                @if (currentMixLog == null && mixLogs.Count == 0)
                {
                    <div class="bg-white rounded-lg shadow-md p-8 text-center text-gray-400">
                        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                        </svg>
                        <p>Noch keine Experimente. Elemente ablegen und Mischen drücken!</p>
                    </div>
                }
                else
                {
                    var logsToShow = isHistoryVisible
                        ? GetVisibleMixLogs()
                        : (currentMixLog is null ? Enumerable.Empty<MixLog>() : [currentMixLog]);

                    <div class="space-y-3">
                        @foreach (var log in logsToShow)
                        {
                            <div class="bg-white rounded-lg shadow-md p-3 border-2 border-gray-300">
                                <div class="flex items-start gap-3">
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between gap-2 mb-2">
                                            <div class="flex items-center gap-2">
                                                <div
                                                    style="background-color: @(log.Educt1.CardColorHex)1a; border-color: @(log.Educt1.CardColorHex)80"
                                                    class="border-2 rounded-lg px-2.5 py-1">
                                                    <p class="text-sm font-bold">@log.Educt1.Name</p>
                                                </div>
                                                <span class="font-bold text-gray-600">+</span>
                                                <div
                                                    style="background-color: @(log.Educt2.CardColorHex)1a; border-color: @(log.Educt2.CardColorHex)80"
                                                    class="border-2 rounded-lg px-2.5 py-1">
                                                    <p class="text-sm font-bold">@log.Educt2.Name</p>
                                                </div>
                                            </div>

                                            @if (IsCurrentMix(log))
                                            {
                                                <span class="text-[11px] px-2 py-1 rounded-full bg-blue-100 text-blue-700 font-medium">Aktuell</span>
                                            }
                                            else
                                            {
                                                <span class="text-[11px] px-2 py-1 rounded-full bg-gray-100 text-gray-600 font-medium">Historie</span>
                                            }
                                        </div>

                                        <div class="flex items-start gap-3">
                                            <div class="flex-1 h-24 p-3 rounded-lg bg-blue-50 border border-blue-100 flex items-center">
                                                <div class="grid grid-cols-2 gap-3 w-full">
                                                    <div>
                                                        <p class="text-sm text-gray-600 mb-0.5">Formel:</p>
                                                        <p class="font-medium font-mono text-lg text-blue-800">@log.Formula</p>
                                                    </div>
                                                    <div>
                                                        <p class="text-sm text-gray-600 mb-0.5">Ergebnis:</p>
                                                        <p class="font-bold text-2xl text-blue-700">@log.Result</p>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="w-36 shrink-0 flex flex-col items-center gap-1.5">
                                                <div class="relative group w-full h-24 bg-gray-50 rounded-lg border border-gray-300 flex items-center justify-center cursor-zoom-in">
                                                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                                                    </svg>

                                                    <div class="hidden group-hover:flex fixed inset-0 z-50 items-center justify-center bg-black/20 pointer-events-none">
                                                        <div class="w-[600px] h-[600px] bg-gray-50 rounded-xl border border-gray-300 shadow-2xl flex items-center justify-center">
                                                            <svg class="w-52 h-52 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 2v8l3 6v6h2v-6l3-6V2H8z" />
                                                            </svg>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <p class="text-xs text-gray-500 mt-2">@log.Timestamp.ToString("HH:mm:ss")</p>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!isHistoryVisible && mixLogs.Count > 0)
                        {
                            <div class="text-center text-xs text-gray-500">
                                @mixLogs.Count ältere Einträge ausgeblendet
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Side - Product List -->
        <div class="w-[28rem] bg-white border-l border-gray-200 p-4 flex flex-col"
             @ondrop="HandleReturnToListDrop"
             @ondrop:preventDefault
             @ondragover:preventDefault>
            <div class="flex items-center justify-between mb-3">
                <h2 class="font-semibold">Verfügbare Verbindungen</h2>
                <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">@educts.Count Elemente</span>
            </div>

            <!-- Search -->
            <div class="relative mb-4"
                 @ondrop="@((DragEventArgs e) => HandleDropOnSearch(e))"
                 @ondrop:preventDefault
                 @ondragover:preventDefault
                 @ondragleave="HandleDragLeaveSearch">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text"
                       placeholder="Verbindungen suchen..."
                       value="@searchQuery"
                       @oninput="@((ChangeEventArgs e) => { searchQuery = e.Value?.ToString() ?? ""; HandleSearch(searchQuery); })"
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <!-- Product List -->
            <div class="flex-1 overflow-y-auto hide-scrollbar space-y-2">
                @foreach (var edukt in filteredEducts)
                {
                    <div draggable="true"
                         @ondragstart="@(() => HandleDragStart(edukt))"
                         @ondragend="HandleDragEnd"
                         @onclick="() => SelectEduct(edukt)"
                         style="background-color: @(edukt.CardColorHex)1a; border-color: @(edukt.CardColorHex)80"
                         class="w-full border-2 rounded-lg p-3 cursor-grab hover:shadow-md transition-all text-left @(_selectedEductVm?.Id == edukt.Id ? "ring-2 ring-blue-500" : "") @(_draggedEductVm?.Id == edukt.Id ? "opacity-50" : "")">
                        <p class="font-bold text-base mb-1">@edukt.Name</p>
                        <p class="text-xs text-gray-600 mb-2 font-medium">@edukt.Type</p>

                        <div class="grid grid-cols-3 gap-1.5">
                            <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                         style="color: @edukt.PhLevel.HexValue">
                                        <circle cx="12" cy="12" r="8" />
                                    </svg>
                                    <span
                                        class="text-[11px] font-medium text-gray-700 leading-tight">pH: @edukt.PhLevel.Name</span>
                                </div>
                                <div style="background-color: @edukt.PhLevel.HexValue"
                                     class="h-2.5 rounded border border-gray-400"></div>
                            </div>

                            <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                         style="color: @edukt.FlameColor.HexValue">
                                        <path d="M12 2C12 2 6 8 6 13c0 3.3 2.7 6 6 6s6-2.7 6-6c0-5-6-11-6-11zm0 16c-1.6 0-3-1.4-3-3 0-1.8 1.5-3.5 3-5.1 1.5 1.6 3 3.3 3 5.1 0 1.6-1.4 3-3 3z"/>
                                    </svg>
                                    <span
                                        class="text-[11px] font-medium text-gray-700 leading-tight">Flamme: @edukt.FlameColor.Name</span>
                                </div>
                                <div style="background-color: @edukt.FlameColor.HexValue"
                                     class="h-2.5 rounded border border-gray-400"></div>
                            </div>

                            <div class="flex-1 flex flex-col gap-0.5 bg-white/75 px-2.5 py-1.5 rounded-md border border-gray-300">
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                                         style="color: @edukt.ElementColor.HexValue">
                                        <circle cx="12" cy="12" r="8" />
                                    </svg>
                                    <span
                                        class="text-[11px] font-medium text-gray-700 leading-tight">Farbe: @edukt.ElementColor.Name</span>
                                </div>
                                <div style="background-color: @edukt.ElementColor.HexValue"
                                     class="h-2.5 rounded border border-gray-400"></div>
                            </div>
                        </div>

                        <p class="text-xs text-gray-500 mt-2 font-medium">@(_selectedEductVm?.Id == edukt.Id ? "✓ Ausgewählt" : "Ziehen oder Klick")</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {

    private sealed record ColorInfo(string Name, string HexValue);

    private class EductVm
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Type { get; set; }
        public string CardColorHex { get; set; }
        public ColorInfo PhLevel { get; set; }
        public ColorInfo FlameColor { get; set; }
        public ColorInfo ElementColor { get; set; }
    }

    private class MixLog
    {
        public string Id { get; set; }
        public EductVm Educt1 { get; set; }
        public EductVm Educt2 { get; set; }
        public string Result { get; set; }
        public string Formula { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private List<EductVm> educts = [];
    private List<LabReactionDto> _allReactions = [];

    private EductVm _box1EductVm;
    private EductVm _box2EductVm;
    private MixLog? currentMixLog;
    private readonly List<MixLog> mixLogs = new();
    private string searchQuery = "";
    private List<EductVm> filteredEducts = [];
    private EductVm _selectedEductVm;
    private EductVm _draggedEductVm;
    private bool isDragOver1;
    private bool isDragOver2;
    private bool isHistoryVisible;

    protected override async Task OnInitializedAsync()
    {
        var chemicals = await ChemistryData.GetAllChemicalsAsync();
        _allReactions = await ChemistryData.GetAllReactionsAsync();
        educts = chemicals.Select(MapChemical).ToList();
        filteredEducts = educts;
        isHistoryVisible = false;
    }

    private static readonly ColorInfo DefaultColor = new("Keine", "#9ca3af");

    private static EductVm MapChemical(LabChemicalDto c)
    {
        var ph = c.MethodOutputs.TryGetValue("pH-Papier", out var p) ? new ColorInfo(p.Name, p.HexValue) : DefaultColor;
        var flame = c.MethodOutputs.TryGetValue("Flammenfärbung", out var f) ? new ColorInfo(f.Name, f.HexValue) : DefaultColor;
        return new EductVm
        {
            Id = c.ChemicalID,
            Name = c.Name,
            Type = c.Formula,
            CardColorHex = c.Color.HexValue,
            PhLevel = ph,
            FlameColor = flame,
            ElementColor = new ColorInfo(c.Color.Name, c.Color.HexValue),
        };
    }

    private void HandleSearch(string query)
    {
        searchQuery = query;
        filteredEducts = educts.Where(e =>
            e.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            e.Type.Contains(query, StringComparison.OrdinalIgnoreCase)
        ).ToList();
        StateHasChanged();
    }

    private void SelectEduct(EductVm eductVm)
    {
        _selectedEductVm = _selectedEductVm?.Id == eductVm.Id ? null : eductVm;
        StateHasChanged();
    }

    private void PlaceEduct(int boxNumber)
    {
        if (_selectedEductVm != null)
        {
            if (boxNumber == 1)
                _box1EductVm = _selectedEductVm;
            else
                _box2EductVm = _selectedEductVm;
            _selectedEductVm = null;
            StateHasChanged();
        }
    }

    private void HandleMix()
    {
        if (_box1EductVm == null || _box2EductVm == null) return;

        var reaction = _allReactions.FirstOrDefault(r =>
            (r.Chemical1ID == _box1EductVm.Id && r.Chemical2ID == _box2EductVm.Id) ||
            (r.Chemical1ID == _box2EductVm.Id && r.Chemical2ID == _box1EductVm.Id));

        var result = reaction?.RelevantProduct ?? "Keine Reaktion bekannt";
        var formula = reaction?.Formula ?? $"{_box1EductVm.Name} + {_box2EductVm.Name} → ?";

        var log = new MixLog
        {
            Id = DateTime.Now.Ticks.ToString(),
            Educt1 = _box1EductVm,
            Educt2 = _box2EductVm,
            Result = result,
            Formula = formula,
            Timestamp = DateTime.Now
        };

        if (currentMixLog != null)
            mixLogs.Insert(0, currentMixLog);

        currentMixLog = log;
    }

    private IEnumerable<MixLog> GetVisibleMixLogs()
    {
        if (currentMixLog != null)
            yield return currentMixLog;
        foreach (var log in mixLogs)
            yield return log;
    }

    private bool IsCurrentMix(MixLog log) => currentMixLog?.Id == log.Id;

    private void HandleClear()
    {
        _box1EductVm = null;
        _box2EductVm = null;
        _selectedEductVm = null;
    }

    private void HandleDeleteLog(string logId)
    {
        mixLogs.RemoveAll(l => l.Id == logId);
    }

    private void HandleDragStart(EductVm eductVm)
    {
        _draggedEductVm = eductVm;
        StateHasChanged();
    }

    private void HandleDragEnd()
    {
        _draggedEductVm = null;
        isDragOver1 = false;
        isDragOver2 = false;
        StateHasChanged();
    }

    private void HandleDragOver1() { isDragOver1 = true; StateHasChanged(); }
    private void HandleDragOver2() { isDragOver2 = true; StateHasChanged(); }
    private void HandleDragLeave1() { isDragOver1 = false; StateHasChanged(); }
    private void HandleDragLeave2() { isDragOver2 = false; StateHasChanged(); }
    private void HandleDragLeaveSearch() { StateHasChanged(); }

    private void HandleDrop(DragEventArgs e, int boxNumber)
    {
        if (_draggedEductVm != null)
        {
            if (boxNumber == 1) _box1EductVm = _draggedEductVm;
            else if (boxNumber == 2) _box2EductVm = _draggedEductVm;
            _draggedEductVm = null;
            isDragOver1 = false;
            isDragOver2 = false;
            StateHasChanged();
        }
    }

    private void HandleDropOnSearch(DragEventArgs e)
    {
        if (_draggedEductVm != null)
        {
            searchQuery = _draggedEductVm.Name;
            HandleSearch(searchQuery);
            _draggedEductVm = null;
            StateHasChanged();
        }
    }

    private void HandleReturnToListDrop(DragEventArgs e)
    {
        if (_draggedEductVm == null) return;
        if (_box1EductVm?.Id == _draggedEductVm.Id) _box1EductVm = null;
        if (_box2EductVm?.Id == _draggedEductVm.Id) _box2EductVm = null;
        _selectedEductVm = null;
        _draggedEductVm = null;
        isDragOver1 = false;
        isDragOver2 = false;
        StateHasChanged();
    }

    private void ToggleHistory()
    {
        isHistoryVisible = !isHistoryVisible;
    }
}
